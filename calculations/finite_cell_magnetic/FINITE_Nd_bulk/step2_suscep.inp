# STEP2 : full SA-CASSCF + SOC + AILFT in perfect Bulk field, reads step1.gbw
! DKH2 RIJCOSX SARC2-DKH-QZVP AutoAux CASSCF MORead
%moinp "step2.gbw"
%maxcore 14000
%pal nprocs 16 end
%pointcharges "Bulk_defect.pc"
%casscf
  nel  3
  norb 7
  mult 4,2
  nroots 35,112
  orbstep SuperCI
  switchstep DIIS
  shiftup 0.5
  shiftdn 0.5
  minshift 0.1
  rel
    dosoc true
    printlevel 3
    gtensor true
    dosusceptibility true
    susctensor_nfields 1
    susctensor_magfields[0] = 1000,0,0
  end
  actorbs forbs
end
