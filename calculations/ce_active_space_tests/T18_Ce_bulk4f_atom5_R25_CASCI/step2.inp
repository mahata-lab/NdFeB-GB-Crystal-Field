# STEP2 : SA-CASCI (NoIter, free-ion 4f orbitals) + SOC + AILFT + g-tensor
! DKH2 RIJCOSX SARC2-DKH-QZVP AutoAux CASSCF MORead NoIter
%moinp "step0.gbw"
%maxcore 14000
%pal nprocs 16 end
%pointcharges "sphere.pc"
%casscf
  ActConstraints 1
  nel  1
  norb 7
  mult 2
  nroots 7
  maxiter 200
  orbstep    SuperCI
  switchstep DIIS
  shiftup 0.5
  shiftdn 0.5
  minshift 0.1
  rel
    dosoc true
    gtensor true
    printlevel 3
  end
  actorbs forbs
end
