# STEP1 : Tb3+ in GB Ewald field, reads clean atomic 4f from step0.gbw
! DKH2 RIJCOSX SARC2-DKH-QZVP AutoAux CASSCF MORead
%moinp "step0.gbw"
%maxcore 14000
%pal nprocs 16 end
%pointcharges "GB_defect.pc"
%scf
  maxiter 800
end
%casscf
  nel  8
  norb 7
  mult 7
  nroots 7
  maxiter 400
  orbstep    SuperCI
  switchstep DIIS
  shiftup 1.0
  shiftdn 1.0
  minshift 0.2
  actorbs forbs
end
