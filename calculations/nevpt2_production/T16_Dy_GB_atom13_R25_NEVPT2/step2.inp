# STEP2 : SA-CASSCF + SC-NEVPT2 + SOC + AILFT + g-tensor, reads step1.gbw
! DKH2 RIJCOSX SARC2-DKH-QZVP AutoAux CASSCF MORead
%moinp "step1.gbw"
%maxcore 14000
%pal nprocs 16 end
%pointcharges "sphere.pc"
%casscf
  PTMethod SC_NEVPT2
  ActConstraints 1
  nel  9
  norb 7
  mult 6,4
  nroots 21,224
  maxiter 200
  orbstep    SuperCI
  switchstep DIIS
  shiftup 0.5
  shiftdn 0.5
  minshift 0.1
  rel
    dosoc true
    gtensor true
    printlevel 3
  end
  actorbs forbs
end
